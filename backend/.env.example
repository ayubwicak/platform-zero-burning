NODE_ENV=development
PORT=3000
JWT_SECRET=ganti-dengan-secret-yang-aman
DATABASE_URL=sqlite://backend/zero_burning.db
DB_PATH=backend/zero_burning.db

# Storage Configuration
# Driver: "local" (default) atau "s3" (kompatibel S3: AWS S3, Cloudflare R2, Supabase)
STORAGE_DRIVER=local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=zero-burning-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
